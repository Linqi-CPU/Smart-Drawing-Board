.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ---------- 旧版备份（重构前的 main.py，保留在本地但不入库） ----------
main_legacy_v1.py.bak

# ---------- OS 生成文件 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
*.lnk

# ---------- 项目导出物 ----------
drawing.png
*.tmp
*.bak
# 内核启动日志是纯本地噪音：由 core/server.py 每次启动追加写入，
# 记录 pid/ppid/Job 归属用于事后判断进程死因，不该进版本库。
.kernel.log
# Windows 下手滑 `> nul` 会在仓库根留下一个名为 nul 的文件
nul
!functions/*.py

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# 注意：functions/ 下的用户函数应纳入版本管理，
# 因此不要忽略该目录本身，也不要忽略其中的 .py 文件。
